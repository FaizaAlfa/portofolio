---
import { siteConfig } from '../data/site';
---

<footer class="mt-auto border-t border-[var(--color-border)] bg-[#0b0f14] text-xs font-mono py-8 px-4 sm:px-6">
  <div class="max-w-5xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4 text-[var(--color-text-dim)]">
    <div>
      © {new Date().getFullYear()} {siteConfig.author} ({siteConfig.handle}). Built with Astro & Tailwind.
    </div>

    <div class="flex items-center gap-4 text-[var(--color-text-muted)]">
      <a href={siteConfig.socials.github} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--color-accent)]">GitHub</a>
      <a href={siteConfig.socials.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--color-accent)]">LinkedIn</a>
      <a href={siteConfig.socials.ctftime} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--color-accent)]">CTFtime</a>
      <a href="/rss.xml" class="hover:text-[var(--color-accent)]">RSS</a>
    </div>
  </div>
</footer>
