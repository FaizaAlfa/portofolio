---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 - Not Found" description="The requested memory address or route could not be resolved.">
  <div class="max-w-2xl mx-auto my-12">
    <div class="cyber-panel p-6 sm:p-8 space-y-6">
      {/* Window Header */}
      <div class="flex items-center justify-between border-b border-[var(--color-border)] pb-3">
        <div class="flex items-center gap-2">
          <span class="cyber-dot-red"></span>
          <span class="cyber-dot-yellow"></span>
          <span class="cyber-dot-green"></span>
          <span class="font-mono text-xs text-[var(--color-danger)] font-bold ml-2">
            ERR_SEGMENTATION_FAULT (SIGSEGV)
          </span>
        </div>
        <span class="text-[10px] font-mono text-[var(--color-text-dim)]">EXIT_CODE 127</span>
      </div>

      {/* Terminal Error Content */}
      <div class="space-y-4 font-mono text-xs sm:text-sm">
        <div class="space-y-1">
          <div class="flex items-center gap-2 text-[var(--color-text-muted)]">
            <span class="text-[var(--color-accent)] font-bold">faiza@fazer0:~$</span>
            <span class="text-[#ffffff]">resolve_target --url window.location.pathname</span>
          </div>
          <p class="text-[var(--color-danger)] font-bold pl-4">
            bash: target_path: No such file or directory. Page pointer dereferenced NULL (0x00000000).
          </p>
        </div>

        <div class="p-4 rounded bg-[var(--color-bg)] border border-[var(--color-border)] space-y-2">
          <div class="text-[11px] text-[var(--color-text-dim)] uppercase">Suggested Recovery Commands:</div>
          <ul class="space-y-1 text-xs">
            <li>
              <a href="/" class="text-[var(--color-accent)] hover:underline">
                $ cd ~ (Return to Home)
              </a>
            </li>
            <li>
              <a href="/writeups" class="text-[var(--color-accent-2)] hover:underline">
                $ ls /writeups (Browse CTF Archive)
              </a>
            </li>
            <li>
              <a href="/projects" class="text-[var(--color-warning)] hover:underline">
                $ cat /projects (View Tools)
              </a>
            </li>
          </ul>
        </div>
      </div>

      <!-- Quick Action Button -->
      <div class="pt-2 flex justify-center">
        <a
          href="/"
          class="px-6 py-2.5 bg-[var(--color-accent)] hover:bg-[var(--color-accent)]/90 text-[#0b0f14] font-mono font-bold text-xs rounded transition-all shadow-md cursor-pointer"
        >
          [ Return to Base Station / ]
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
