---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { withBase } from '../../data/paths';

export async function getStaticPaths() {
  const projects = await getCollection('projects');

  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, description, repo, demo, challenge, challengeLabel, status } = project.data;
const challengeUrl = challenge
  ? challenge.startsWith('http://') || challenge.startsWith('https://')
    ? challenge
    : withBase(challenge)
  : undefined;
---

<BaseLayout title={title} description={description} type="article">
  <article class="space-y-8">
    <a
      href={withBase('/projects')}
      class="inline-flex items-center gap-2 text-xs font-mono text-[var(--color-accent)] hover:underline"
    >
      &larr; Kembali ke Projects
    </a>

    <header class="cyber-panel p-6 sm:p-8 space-y-5">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <span class="px-2 py-1 text-[10px] font-mono font-bold uppercase rounded border border-[var(--color-border)] text-[var(--color-text-muted)]">
          {status}
        </span>
        <div class="flex flex-wrap items-center gap-4 text-xs font-mono">
          {repo && (
            <a href={repo} target="_blank" rel="noopener noreferrer" class="text-[var(--color-text-muted)] hover:text-[var(--color-accent)]">
              GitHub ↗
            </a>
          )}
          {demo && (
            <a href={demo} target="_blank" rel="noopener noreferrer" class="text-[var(--color-accent-2)] hover:underline">
              Demo ↗
            </a>
          )}
        </div>
      </div>

      <div>
        <p class="font-mono text-xs text-[var(--color-accent)] uppercase tracking-wider mb-2">// CTF CHALLENGE</p>
        <h1 class="text-2xl sm:text-3xl font-extrabold font-mono text-[var(--color-text)] tracking-tight">
          {title}
        </h1>
        <p class="mt-3 text-sm text-[var(--color-text-muted)] leading-relaxed">{description}</p>
      </div>

      {challengeUrl && (
        <a
          href={challengeUrl}
          download={!challenge?.startsWith('http://') && !challenge?.startsWith('https://')}
          target={challenge?.startsWith('http://') || challenge?.startsWith('https://') ? '_blank' : undefined}
          rel={challenge?.startsWith('http://') || challenge?.startsWith('https://') ? 'noopener noreferrer' : undefined}
          class="inline-flex items-center gap-2 rounded border border-[var(--color-accent)]/40 bg-[var(--color-accent)]/10 px-4 py-2.5 text-xs font-mono font-bold text-[var(--color-accent)] hover:bg-[var(--color-accent)]/20 transition-colors"
        >
          {challengeLabel ?? 'Download challenge'} ↗
        </a>
      )}

    </header>

    <section class="cyber-panel p-6 sm:p-8">
      <div class="space-y-4 text-sm text-[var(--color-text-muted)] leading-relaxed [&_h2]:font-mono [&_h2]:text-lg [&_h2]:font-bold [&_h2]:text-[var(--color-text)]">
        <Content />
      </div>
    </section>
  </article>
</BaseLayout>
