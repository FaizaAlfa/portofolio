---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../data/site';

const ctfEntries = await getCollection('ctf');

// Urutan asli kronologis berdasarkan tanggal pelaksanaan kompetisi (terbaru ke terlama)
const sortedEntries = ctfEntries.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Calculate solve category distribution
const categoryCounts: Record<string, number> = {};
ctfEntries.forEach((entry) => {
  entry.data.categoriesSolved.forEach((cat) => {
    categoryCounts[cat] = (categoryCounts[cat] || 0) + 1;
  });
});

const totalEvents = ctfEntries.length;
const rankedEntries = ctfEntries.filter((entry) => entry.data.rank !== undefined);
const topRank = Math.min(...rankedEntries.map((entry) => entry.data.rank!));

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('id-ID', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  }).format(date);
};
---

<BaseLayout
  title="CTF Competition History & Timeline"
  description="Rekam jejak kompetisi CTF, peringkat turnamen nasional/kampus, dan arsip solusi teknis oleh Faiza (FAZer0)."
>
  <!-- Page Header -->
  <div class="mb-10">
    <div class="flex items-center gap-2 font-mono text-xs text-[var(--color-accent)] font-bold uppercase tracking-wider mb-2">
      <span class="w-2 h-2 rounded-full bg-[var(--color-accent)] animate-pulse"></span>
      <span>// 02. COMPETITIONS & TIMELINE</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-extrabold font-mono text-[var(--color-text)] tracking-tight">
      CTF <span class="text-[var(--color-accent)]">Track Record</span>
    </h1>
    <p class="text-sm sm:text-base text-[var(--color-text-muted)] mt-2 font-mono">
      Kronologi riwayat kompetisi CTF, pencapaian tim, dan tautan langsung ke writeup teknis yang diselesaikan.
    </p>
  </div>

  <!-- Profiles & Summary Metrics Bar -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-10">
    <!-- Stat 1: Total Events -->
    <div class="cyber-panel p-5">
      <div class="text-[10px] font-mono uppercase tracking-wider text-[var(--color-text-dim)]">
        Total Kompetisi
      </div>
      <div class="text-2xl sm:text-3xl font-mono font-extrabold text-[var(--color-accent)] mt-1">
        {totalEvents} <span class="text-xs font-normal text-[var(--color-text-muted)]">Tournaments</span>
      </div>
      <p class="text-xs text-[var(--color-text-muted)] mt-1 font-mono">
        Terdokumentasi lengkap dengan writeup
      </p>
    </div>

    <!-- Stat 2: Highest Achievement -->
    <div class="cyber-panel p-5">
      <div class="text-[10px] font-mono uppercase tracking-wider text-[var(--color-text-dim)]">
        Pencapaian Tertinggi
      </div>
      <div class="text-2xl sm:text-3xl font-mono font-extrabold text-[var(--color-accent-2)] mt-1">
        Rank #{topRank} <span class="text-xs font-normal text-[var(--color-text-muted)]">Freepass POROS</span>
      </div>
      <p class="text-xs text-[var(--color-text-muted)] mt-1 font-mono">
        5,399 Points • 7 Kategori Solved
      </p>
    </div>

    <!-- Stat 3: CTFtime Profile -->
    <div class="cyber-panel p-5 flex flex-col justify-between">
      <div>
        <div class="text-[10px] font-mono uppercase tracking-wider text-[var(--color-text-dim)]">
          Public Profile
        </div>
        <div class="text-lg font-mono font-bold text-[var(--color-text)] mt-1">
          CTFtime.org
        </div>
        <p class="text-xs text-[var(--color-text-muted)] mt-0.5 font-mono">
          Handle: <strong class="text-[var(--color-accent)]">{siteConfig.handle}</strong>
        </p>
      </div>
      <a
        href={siteConfig.socials.ctftime}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-3 inline-flex items-center gap-1 text-xs font-mono font-semibold text-[var(--color-accent)] hover:underline"
      >
        <span>View CTFtime Profile</span>
        <span>↗</span>
      </a>
    </div>
  </div>

  <!-- Category Solves Breakdown Grid -->
  <div class="cyber-panel p-5 mb-12">
    <div class="text-[10px] font-mono uppercase tracking-wider text-[var(--color-text-dim)] mb-3">
      Distribusi Solved Categories Lintas Kompetisi
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-2.5">
      {Object.entries(categoryCounts).map(([category, count]) => (
        <div class="p-2.5 rounded bg-[var(--color-bg)] border border-[var(--color-border)] text-center">
          <span class="text-[11px] font-mono text-[var(--color-text-muted)] block truncate">{category}</span>
          <span class="text-sm font-mono font-bold text-[var(--color-accent)]">{count} Event</span>
        </div>
      ))}
    </div>
  </div>

  <!-- Timeline Section -->
  <section class="space-y-6">
    <div class="flex items-center justify-between border-b border-[var(--color-border)] pb-3">
      <div class="flex items-center gap-2 font-mono text-sm uppercase tracking-wider text-[var(--color-text)] font-bold">
        <span class="text-[var(--color-accent)]">&gt;&gt;</span>
        <span>Urutan Kronologis Kompetisi & Writeup</span>
      </div>
      <span class="text-xs font-mono text-[var(--color-text-dim)]">
        Terurut dari yang paling terbaru
      </span>
    </div>

    <div class="relative border-l-2 border-[var(--color-border)] ml-3 sm:ml-6 pl-6 sm:pl-8 space-y-8 pt-2">
      {sortedEntries.map((entry, idx) => {
        const { event, year, date, team, rank, totalTeams, categoriesSolved, link, writeupSlug } = entry.data;

        return (
          <div class="relative group">
            {/* Timeline Node Dot */}
            <div class="absolute -left-[31px] sm:-left-[39px] top-1.5 w-4 h-4 rounded-full bg-[var(--color-surface)] border-2 border-[var(--color-accent)] group-hover:scale-125 transition-transform flex items-center justify-center">
              <div class="w-1.5 h-1.5 rounded-full bg-[var(--color-accent)]"></div>
            </div>

            <div class="cyber-panel p-5 sm:p-6 space-y-4 hover:border-[var(--color-accent)]/40 transition-colors">
              {/* Event Header */}
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-[var(--color-border)] pb-3">
                <div>
                  <div class="flex flex-wrap items-center gap-2 mb-1">
                    <span class="px-2 py-0.5 text-[10px] font-mono font-bold text-[var(--color-accent-2)] bg-[var(--color-accent-2)]/10 border border-[var(--color-accent-2)]/30 rounded uppercase">
                      {formatDate(date)}
                    </span>
                    <span class="text-[10px] font-mono text-[var(--color-text-dim)]">
                      #{idx + 1}
                    </span>
                  </div>
                  <h2 class="text-base sm:text-lg font-mono font-bold text-[var(--color-text)] group-hover:text-[var(--color-accent)] transition-colors">
                    {event}
                  </h2>
                </div>

                {/* Rank Badge */}
                <div class="flex items-center gap-2 shrink-0">
                  <span class={`px-3 py-1 rounded font-mono font-extrabold text-xs border ${
                    rank === 1
                      ? 'bg-amber-500/15 text-amber-400 border-amber-500/50'
                      : rank !== undefined && rank <= 5
                      ? 'bg-[var(--color-accent)]/15 text-[var(--color-accent)] border-[var(--color-accent)]/40'
                      : 'bg-[var(--color-surface-hover)] text-[var(--color-text-muted)] border-[var(--color-border)]'
                  }`}>
                    {rank !== undefined ? `${rank === 1 ? '🏆 ' : ''}Rank #${rank}${totalTeams ? ` / ${totalTeams} Tim` : ''}` : 'Rank belum tersedia'}
                  </span>
                </div>
              </div>

              {/* Team Information */}
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs font-mono">
                <div>
                  <span class="text-[var(--color-text-dim)] uppercase text-[10px] block">Nama Tim / Partisipan:</span>
                  <span class="text-[var(--color-text)] font-semibold">{team}</span>
                </div>
                <div class="sm:text-right flex items-center sm:justify-end gap-3 pt-1 sm:pt-0">
                  {link && (
                    <a
                      href={link}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-[var(--color-accent-2)] hover:underline inline-flex items-center gap-1"
                    >
                      <span>Info Event</span>
                      <span>↗</span>
                    </a>
                  )}
                  {writeupSlug && (
                    <a
                      href={`/writeups/${writeupSlug}`}
                      class="px-2.5 py-1 rounded bg-[var(--color-accent)]/10 hover:bg-[var(--color-accent)] hover:text-[#0b0f14] text-[var(--color-accent)] border border-[var(--color-accent)]/30 font-bold inline-flex items-center gap-1.5 transition-colors"
                    >
                      <span>📄 Baca Writeup</span>
                      <span>&rarr;</span>
                    </a>
                  )}
                </div>
              </div>

              {/* Solved category pills */}
              <div class="pt-1 flex flex-wrap gap-1.5 items-center">
                <span class="text-[10px] font-mono text-[var(--color-text-dim)] uppercase mr-1">Solved:</span>
                {categoriesSolved.map((cat) => (
                  <span class="px-2 py-0.5 text-[10px] font-mono bg-[var(--color-bg)] border border-[var(--color-border)] text-[var(--color-text-muted)] rounded">
                    ✓ {cat}
                  </span>
                ))}
              </div>

              {/* Entry Body Description */}
              {entry.body && (
                <p class="text-xs text-[var(--color-text-muted)] pt-3 border-t border-[var(--color-border-subtle)] leading-relaxed">
                  {entry.body}
                </p>
              )}
            </div>
          </div>
        );
      })}
    </div>
  </section>
</BaseLayout>
