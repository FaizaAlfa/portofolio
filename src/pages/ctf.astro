---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../data/site';

const ctfEntries = await getCollection('ctf');
const sortedEntries = ctfEntries.sort((a, b) => b.data.year - a.data.year || a.data.rank - b.data.rank);

// Calculate solve category distribution
const categoryCounts: Record<string, number> = {};
ctfEntries.forEach((entry) => {
  entry.data.categoriesSolved.forEach((cat) => {
    categoryCounts[cat] = (categoryCounts[cat] || 0) + 1;
  });
});
---

<BaseLayout title="CTF Competition History" description="Competition history, tournament rankings, and category breakdown for Faiza (FAZer0).">
  <!-- Page Header -->
  <div class="mb-10">
    <div class="flex items-center gap-2 font-mono text-xs text-[var(--color-accent)] font-bold uppercase tracking-wider mb-2">
      <span>// 02. COMPETITIONS</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-extrabold font-mono text-[var(--color-text)] tracking-tight">
      CTF <span class="text-[var(--color-accent)]">Track Record</span>
    </h1>
    <p class="text-sm sm:text-base text-[var(--color-text-muted)] mt-2 font-mono">
      Competition timeline, national rankings, and team achievements.
    </p>
  </div>

  <!-- Profiles & Summary Metrics Bar -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
    <!-- CTFtime Profile Card -->
    <div class="cyber-panel p-5 flex flex-col justify-between">
      <div>
        <div class="text-[10px] font-mono uppercase tracking-wider text-[var(--color-text-dim)]">
          Public Profile
        </div>
        <div class="text-lg font-mono font-bold text-[var(--color-text)] mt-1">
          CTFtime.org
        </div>
        <p class="text-xs text-[var(--color-text-muted)] mt-1">
          Handle: <strong class="text-[var(--color-accent)]">{siteConfig.handle}</strong>
        </p>
      </div>
      <a
        href={siteConfig.socials.ctftime}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-4 inline-flex items-center gap-1.5 text-xs font-mono font-semibold text-[var(--color-accent)] hover:underline"
      >
        <span>View CTFtime Profile</span>
        <span>↗</span>
      </a>
    </div>

    <!-- Category Solves Breakdown -->
    <div class="cyber-panel p-5 md:col-span-2">
      <div class="text-[10px] font-mono uppercase tracking-wider text-[var(--color-text-dim)] mb-3">
        Solved Categories Across Competitions
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
        {Object.entries(categoryCounts).map(([category, count]) => (
          <div class="p-2.5 rounded bg-[var(--color-bg)] border border-[var(--color-border)]">
            <span class="text-xs font-mono text-[var(--color-text-muted)] block truncate">{category}</span>
            <span class="text-base font-mono font-bold text-[var(--color-accent)]">{count} events</span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Timeline Section -->
  <section class="space-y-6">
    <div class="flex items-center gap-2 font-mono text-sm uppercase tracking-wider text-[var(--color-text)] font-bold mb-4">
      <span class="text-[var(--color-accent)]">&gt;&gt;</span>
      <span>Tournament Timeline</span>
    </div>

    <div class="relative border-l-2 border-[var(--color-border)] ml-3 sm:ml-6 pl-6 sm:pl-8 space-y-8">
      {sortedEntries.map((entry) => {
        const { event, year, team, rank, totalTeams, categoriesSolved, link } = entry.data;

        return (
          <div class="relative group">
            {/* Timeline Node Dot */}
            <div class="absolute -left-[31px] sm:-left-[39px] top-1.5 w-4 h-4 rounded-full bg-[var(--color-surface)] border-2 border-[var(--color-accent)] group-hover:scale-125 transition-transform"></div>

            <div class="cyber-panel p-5 sm:p-6 space-y-3">
              {/* Event Header */}
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-[var(--color-border)] pb-3">
                <div>
                  <span class="text-[10px] font-mono font-bold text-[var(--color-accent-2)] uppercase">
                    {year} Edition
                  </span>
                  <h3 class="text-base sm:text-lg font-mono font-bold text-[var(--color-text)]">
                    {event}
                  </h3>
                </div>

                {/* Rank Badge */}
                <div class="flex items-center gap-2">
                  <span class="px-3 py-1 rounded bg-[var(--color-accent)]/10 border border-[var(--color-accent)]/40 text-[var(--color-accent)] font-mono font-extrabold text-xs">
                    Rank #{rank} {totalTeams ? `/ ${totalTeams}` : ''}
                  </span>
                </div>
              </div>

              {/* Team and Solved Categories */}
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs font-mono">
                <div>
                  <span class="text-[var(--color-text-dim)] uppercase text-[10px]">Team:</span>
                  <span class="text-[var(--color-text)] ml-1 font-semibold">{team}</span>
                </div>
                {link && (
                  <div class="sm:text-right">
                    <a
                      href={link}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-[var(--color-accent-2)] hover:underline inline-flex items-center gap-1"
                    >
                      <span>Event Info</span>
                      <span>↗</span>
                    </a>
                  </div>
                )}
              </div>

              {/* Solved category pills */}
              <div class="pt-2 flex flex-wrap gap-1.5">
                {categoriesSolved.map((cat) => (
                  <span class="px-2 py-0.5 text-[10px] font-mono bg-[var(--color-bg)] border border-[var(--color-border)] text-[var(--color-text-muted)] rounded">
                    ✓ {cat}
                  </span>
                ))}
              </div>

              {/* Optional Entry Body */}
              {entry.body && (
                <p class="text-xs text-[var(--color-text-muted)] pt-2 border-t border-[var(--color-border-subtle)] leading-relaxed">
                  {entry.body}
                </p>
              )}
            </div>
          </div>
        );
      })}
    </div>
  </section>
</BaseLayout>
